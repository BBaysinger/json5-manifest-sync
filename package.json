{
  "name": "json5-manifest-sync",
  "version": "0.3.2",
  "description": "Sync package.json and package.json5 manifests in either direction, preserving JSON5 comments where possible.",
  "author": {
    "name": "Bradley Baysinger",
    "url": "https://github.com/BBaysinger"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BBaysinger/json5-manifest-sync.git"
  },
  "homepage": "https://github.com/BBaysinger/json5-manifest-sync#readme",
  "bugs": {
    "url": "https://github.com/BBaysinger/json5-manifest-sync/issues"
  },
  "type": "module",
  "main": "./dist/json5-manifest-sync.js",
  "types": "./dist/json5-manifest-sync.d.ts",
  "exports": {
    ".": {
      "types": "./dist/json5-manifest-sync.d.ts",
      "default": "./dist/json5-manifest-sync.js"
    }
  },
  "bin": {
    "json5-manifest-sync": "dist/json5-manifest-sync.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "sync:json5": "node ./dist/json5-manifest-sync.js --blank-comments=fill",
    "warn:blank-comments": "node ./scripts/warn-blank-comments.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "precommit": "node ./scripts/precommit.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "glob": "^14.0.4",
    "ignore": "^7.0.14",
    "json5": "^2.2.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
